{
  "Description": "TC10-TC20 request and expected-response data for API01_CreateTokenTest",
  "TC10": {
    "Description": "Create token with valid username and password",
    "requestBody": "{\"username\":\"admin\",\"password\":\"password123\"}",
    "expectedStatusCode": 200,
    "expectedResponseField": "token",
    "expectedResponseValue": null
  },
  "TC11": {
    "Description": "Verify token generation without a request body",
    "requestBody": null,
    "expectedStatusCode": 200,
    "expectedResponseField": null,
    "expectedResponseValue": null
  },
  "TC12": {
    "Description": "Verify token generation with an empty JSON body",
    "requestBody": "{}",
    "expectedStatusCode": 200,
    "expectedResponseField": "reason",
    "expectedResponseValue": "Bad credentials"
  },
  "TC13": {
    "Description": "Verify token generation without a username",
    "requestBody": "{\"password\":\"password123\"}",
    "expectedStatusCode": 200,
    "expectedResponseField": "reason",
    "expectedResponseValue": "Bad credentials"
  },
  "TC14": {
    "Description": "Verify token generation without a password",
    "requestBody": "{\"username\":\"admin\"}",
    "expectedStatusCode": 200,
    "expectedResponseField": "reason",
    "expectedResponseValue": "Bad credentials"
  },
  "TC15": {
    "Description": "Verify token generation with an invalid username",
    "requestBody": "{\"username\":\"invalid-user\",\"password\":\"password123\"}",
    "expectedStatusCode": 200,
    "expectedResponseField": "reason",
    "expectedResponseValue": "Bad credentials"
  },
  "TC16": {
    "Description": "Verify token generation with an invalid password",
    "requestBody": "{\"username\":\"admin\",\"password\":\"invalid-password\"}",
    "expectedStatusCode": 200,
    "expectedResponseField": "reason",
    "expectedResponseValue": "Bad credentials"
  },
  "TC17": {
    "Description": "Verify token generation with both credentials invalid",
    "requestBody": "{\"username\":\"invalid-user\",\"password\":\"invalid-password\"}",
    "expectedStatusCode": 200,
    "expectedResponseField": "reason",
    "expectedResponseValue": "Bad credentials"
  },
  "TC18": {
    "Description": "Verify token generation with username as a number",
    "requestBody": "{\"username\":12345,\"password\":\"password123\"}",
    "expectedStatusCode": 200,
    "expectedResponseField": "reason",
    "expectedResponseValue": "Bad credentials"
  },
  "TC19": {
    "Description": "Verify token generation with password as a boolean",
    "requestBody": "{\"username\":\"admin\",\"password\":true}",
    "expectedStatusCode": 200,
    "expectedResponseField": "reason",
    "expectedResponseValue": "Bad credentials"
  },
  "TC20": {
    "Description": "Verify token generation with malformed JSON",
    "requestBody": "{\"username\":\"admin\" \"password\":\"password123\"}",
    "expectedStatusCode": 400,
    "expectedResponseField": null,
    "expectedResponseValue": null
  }
}